<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sinka — Anmeldung</title>
  <!-- Styles are inlined so the page renders before authentication, while the
       static asset directory is gated behind the admin login. -->
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: flex; align-items: center;
           justify-content: center; font-family: system-ui, sans-serif;
           background: #1f2937; color: #111; }
    .card { background: #fff; padding: 2rem; border-radius: 10px; width: 320px;
            box-shadow: 0 10px 30px rgba(0,0,0,.3); }
    h1 { margin: 0 0 1.25rem; font-size: 1.25rem; text-align: center; }
    label { display: block; font-size: .8rem; margin: .75rem 0 .25rem; color: #374151; }
    input { width: 100%; padding: .6rem; border: 1px solid #d1d5db; border-radius: 6px; }
    button { width: 100%; margin-top: 1.25rem; padding: .65rem; border: 0;
             border-radius: 6px; background: #2563eb; color: #fff; font-size: 1rem;
             cursor: pointer; }
    button:hover { background: #1d4ed8; }
    .error { background: #fee2e2; color: #991b1b; padding: .6rem; border-radius: 6px;
             font-size: .85rem; margin-bottom: 1rem; text-align: center; }
  </style>
</head>
<body>
  <form class="card" method="POST" action="/login">
    <h1>Sinka Admin</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <label for="username">Benutzername</label>
    <input id="username" name="username" autocomplete="username" autofocus required>
    <label for="password">Passwort</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit">Anmelden</button>
  </form>
</body>
</html>
