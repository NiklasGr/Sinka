<h1>File Viewer</h1>
<p>Abgaben und synchronisierte Dateien prüfen. Links durch den Tresor navigieren und eine
Datei zum Anzeigen öffnen. Direkt darstellbar: Bilder, PDF und Text; andere Dateien
werden heruntergeladen.</p>

<div class="rv-layout">
  <aside class="rv-browser">
    <div class="rv-browser__path" id="rv-path">Wird geladen…</div>
    <div class="rv-folder-actions">
      <button type="button" id="rv-upload-btn"
              title="Lokale Dateien in den angezeigten Ordner legen. Liegt er in einem synchronisierten Kurs, werden sie beim nächsten Abgleich auf Stud.IP / IServ übertragen.">⬆ Datei hochladen</button>
      <input type="file" id="rv-upload-input" multiple hidden>
    </div>
    <!-- Shared message slot: per-file downloads in the list below, and uploads above. -->
    <span class="rv-folder-msg" id="rv-folder-msg"></span>
    <div class="rv-progress" id="rv-progress" hidden>
      <div class="rv-progress__track"><div class="rv-progress__fill" id="rv-progress-fill"></div></div>
      <div class="rv-progress__label" id="rv-progress-label"></div>
    </div>
    <div class="rv-filter">
      <input type="search" id="rv-search" placeholder="Nach Name / Person filtern…">
      <div class="rv-filter__row">
        <select id="rv-filter-status" title="Nach Prüfstatus filtern">
          <option value="all">Alle Status</option>
          <option value="unreviewed">Ungeprüft</option>
          <option value="reviewed">Gesehen</option>
          <option value="needs-revision">Überarbeiten</option>
          <option value="approved">Akzeptiert</option>
        </select>
        <select id="rv-filter-ext" title="Nach Dateityp filtern">
          <option value="all">Alle Typen</option>
        </select>
        <select id="rv-sort" title="Dateien sortieren">
          <option value="name">Name</option>
          <option value="mtime">Neueste</option>
          <option value="size">Größte</option>
          <option value="status">Status</option>
        </select>
      </div>
    </div>
    <ul class="rv-list" id="rv-dirs"></ul>
    <ul class="rv-list rv-list--files" id="rv-files"></ul>
    <p class="rv-empty" id="rv-empty" style="display:none;">Dieser Ordner enthält keine Dateien.</p>
  </aside>

  <section class="rv-viewer-wrap">
    <div class="rv-viewer-bar">
      <span class="rv-viewer-title" id="rv-viewer-title">Keine Datei ausgewählt</span>
      <span class="rv-split" id="rv-split" title="Vergleichsmodus: Anzahl der Bereiche">
        <button type="button" data-n="1" class="active">1</button>
        <button type="button" data-n="2">2</button>
        <button type="button" data-n="4">4</button>
      </span>
      <span class="rv-img-tools" id="rv-img-tools" hidden>
        <button type="button" id="rv-zoom-out" title="Verkleinern (-)">−</button>
        <span class="rv-zoom-level" id="rv-zoom-level">100%</span>
        <button type="button" id="rv-zoom-in" title="Vergrößern (+)">+</button>
        <button type="button" id="rv-rotate" title="Um 90° drehen (r)">⟳</button>
        <button type="button" id="rv-fit" title="Vollbild / Originalgröße umschalten (f)">Vollbild</button>
      </span>
    </div>
    <div class="rv-panes" id="rv-panes" data-n="1"></div>
  </section>

  <aside class="rv-notes" id="rv-notes" hidden>
    <div class="rv-notes__head">
      <span>Notizen</span>
      <label class="rv-status-wrap">Status
        <select id="rv-status" class="rv-status">
          <option value="unreviewed">Ungeprüft</option>
          <option value="reviewed">Gesehen</option>
          <option value="needs-revision">Überarbeiten</option>
          <option value="approved">Akzeptiert</option>
        </select>
      </label>
    </div>
    <ul class="rv-notes__list" id="rv-notes-list"></ul>
    <form class="rv-notes__form" id="rv-notes-form">
      <textarea id="rv-note-body" rows="3" placeholder="Notiz zu dieser Datei hinzufügen…" maxlength="10000"></textarea>
      <button type="submit">Notiz hinzufügen</button>
      <span class="rv-notes__msg" id="rv-notes-msg"></span>
    </form>
  </aside>
</div>

<style>
  .rv-layout { display: flex; gap: 1rem; margin-top: 1rem; align-items: stretch; height: calc(100vh - 12rem); min-height: 24rem; }
  .rv-browser { flex: 0 0 20rem; display: flex; flex-direction: column; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
  .rv-browser__path { font-family: monospace; font-size: 0.78rem; word-break: break-all; padding: 0.5rem 0.6rem; background: #f6f6f6; border-bottom: 1px solid #eee; }
  .rv-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; }
  .rv-list--files { flex: 1; border-top: 1px solid #f0f0f0; }
  .rv-list li { padding: 0.4rem 0.6rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; }
  .rv-list li:hover { background: #eef; }
  .rv-list li.active { background: #dce6ff; }
  .rv-ico { flex: 0 0 1.1rem; text-align: center; opacity: 0.75; }
  .rv-name { flex: 1; word-break: break-word; }
  .rv-size { flex: 0 0 auto; font-size: 0.72rem; color: #888; }
  .rv-dot { flex: 0 0 0.6rem; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #ccc; }
  .rv-notecount { flex: 0 0 auto; font-size: 0.7rem; color: #667; }
  .rv-download { flex: 0 0 auto; padding: 0 0.25rem; border-radius: 4px; opacity: 0.45; }
  .rv-download:hover { opacity: 1; background: #dce6ff; }
  /* status colours, shared by the file-list dots and the notes-panel select */
  .rv-dot.status-unreviewed { background: #ccc; }
  .rv-dot.status-reviewed { background: #3b82f6; }
  .rv-dot.status-needs-revision { background: #e0a800; }
  .rv-dot.status-approved { background: #2a8; }

  .rv-filter { padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; display: flex; flex-direction: column; gap: 0.3rem; }
  .rv-filter input { font: inherit; font-size: 0.82rem; padding: 0.25rem 0.4rem; width: 100%; box-sizing: border-box; }
  .rv-filter__row { display: flex; gap: 0.3rem; }
  .rv-filter__row select { flex: 1; min-width: 0; font-size: 0.75rem; }

  .rv-progress { padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; }
  .rv-progress__track { height: 0.5rem; background: #eee; border-radius: 999px; overflow: hidden; }
  .rv-progress__fill { height: 100%; width: 0; background: #2a8; transition: width 0.2s; }
  .rv-progress__label { font-size: 0.72rem; color: #667; margin-top: 0.25rem; }
  .rv-file--download .rv-name { color: #555; }
  .rv-empty { padding: 0.6rem; font-size: 0.82rem; color: #888; }

  .rv-viewer-wrap { flex: 1; display: flex; flex-direction: column; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; min-width: 0; }
  .rv-viewer-bar { padding: 0.45rem 0.7rem; background: #f6f6f6; border-bottom: 1px solid #eee; display: flex; align-items: center; gap: 0.6rem; }
  .rv-viewer-title { font-size: 0.9rem; font-weight: bold; word-break: break-all; }
  .rv-split { margin-left: auto; display: flex; gap: 0.2rem; }
  .rv-split button { min-width: 1.8rem; padding: 0.15rem 0.45rem; cursor: pointer; }
  .rv-split button.active { background: #dce6ff; }
  .rv-img-tools { display: flex; align-items: center; gap: 0.3rem; }
  .rv-img-tools button { min-width: 1.8rem; padding: 0.15rem 0.45rem; cursor: pointer; }
  .rv-img-tools button.active { background: #dce6ff; }
  .rv-zoom-level { font-size: 0.78rem; color: #667; min-width: 3.2rem; text-align: center; }

  /* Compare grid: 1, 2 (side by side) or 4 (2x2) panes. */
  .rv-panes { flex: 1; display: grid; gap: 2px; background: #333; min-height: 0; }
  .rv-panes[data-n="1"] { grid-template-columns: 1fr; }
  .rv-panes[data-n="2"] { grid-template-columns: 1fr 1fr; }
  .rv-panes[data-n="4"] { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .rv-pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; outline: 2px solid transparent; outline-offset: -2px; }
  .rv-pane.focused { outline-color: #5b8def; }
  .rv-pane__bar { font-size: 0.75rem; padding: 0.2rem 0.5rem; background: #5a5a5a; color: #eee; word-break: break-all; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 0 0 auto; }
  .rv-panes[data-n="1"] .rv-pane__bar { display: none; } /* redundant with the top bar */
  .rv-pane__body { flex: 1; overflow: auto; background: #4a4a4a; padding: 1rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; min-height: 0; }
  .rv-pane__body.rv-pane__body--img { display: block; overflow: auto; padding: 0; }
  .rv-img-stage { display: flex; align-items: center; justify-content: center; min-width: 100%; min-height: 100%; box-sizing: border-box; }
  .rv-img-stage img { flex: 0 0 auto; max-width: none; }
  .rv-placeholder { color: #ddd; margin: auto; }
  .rv-pane__body img { background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,0.4); }
  .rv-pane__body canvas { max-width: 100%; height: auto; background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,0.4); }
  .rv-pane__body pre { align-self: stretch; background: #fff; color: #111; padding: 1rem; border-radius: 4px; white-space: pre-wrap; word-break: break-word; font-size: 0.85rem; margin: 0; }
  .rv-msg { color: #fff; margin: auto; text-align: center; }
  .rv-msg.error { color: #ffbcbc; }
  .rv-download-link { display: inline-block; margin-top: 0.5rem; color: #cfe0ff; }

  .rv-notes { flex: 0 0 18rem; display: flex; flex-direction: column; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
  .rv-notes__head { padding: 0.5rem 0.7rem; background: #f6f6f6; border-bottom: 1px solid #eee; font-weight: bold; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; }
  .rv-status-wrap { margin-left: auto; font-weight: normal; font-size: 0.75rem; color: #667; display: flex; align-items: center; gap: 0.3rem; }
  .rv-status { font: inherit; font-size: 0.78rem; }
  .rv-folder-actions { display: flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.6rem 0; }
  .rv-folder-actions button { font-size: 0.75rem; padding: 0.15rem 0.5rem; cursor: pointer; }
  .rv-folder-msg { display: block; font-size: 0.74rem; color: #b00; padding: 0.2rem 0.6rem 0; }
  .rv-folder-msg.ok { color: #070; }
  .rv-notes__list { list-style: none; margin: 0; padding: 0.5rem; overflow-y: auto; flex: 1; }
  .rv-notes__empty { color: #999; font-size: 0.82rem; padding: 0.3rem; }
  .rv-note { border: 1px solid #eee; border-radius: 6px; padding: 0.45rem 0.55rem; margin-bottom: 0.5rem; }
  .rv-note__body { font-size: 0.85rem; white-space: pre-wrap; word-break: break-word; }
  .rv-note__meta { font-size: 0.72rem; color: #999; margin-top: 0.3rem; display: flex; gap: 0.5rem; align-items: center; }
  .rv-note__actions { margin-left: auto; display: flex; gap: 0.3rem; }
  .rv-note__actions button { font-size: 0.72rem; padding: 0.05rem 0.35rem; cursor: pointer; }
  .rv-note__edit { width: 100%; box-sizing: border-box; font: inherit; font-size: 0.85rem; }
  .rv-notes__form { border-top: 1px solid #eee; padding: 0.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .rv-notes__form textarea { width: 100%; box-sizing: border-box; font: inherit; font-size: 0.85rem; resize: vertical; }
  .rv-notes__msg { font-size: 0.78rem; min-height: 1em; }
  .rv-notes__msg.error { color: #b00; }
</style>

<script type="module" src="/js/review.js?v=<%= assetVersion %>"></script>
