<h1>Upload Interface</h1>
<p>Zeitlich begrenzte, code-geschützte Sitzungen zum Einsammeln von Dateien. Die Dateien
landen im gewählten Zielordner; ist dieser ein synchronisierter Kurs, erreichen sie
Stud.IP / IServ bei der nächsten Synchronisation.</p>

<section class="au-block">
  <h2>Neue Upload-Sitzung</h2>
  <form id="au-form" class="au-form" onsubmit="createSession(event)">
    <label>Name der Sitzung
      <input id="au-name" required placeholder="z. B. Hausaufgabe Woche 12">
    </label>

    <label>Zielordner
      <select id="au-target">
        <option value="">Synchronisierte Kurse werden geladen…</option>
      </select>
    </label>
    <div class="au-custom-path" style="display:none;">
      <span class="au-custom-path__label">Eigener Ordner</span>
      <div class="au-custom-path__row">
        <button type="button" onclick="openFolderBrowser()">Ordner auswählen…</button>
        <span id="au-target-custom" class="au-custom-path__display">Kein Ordner ausgewählt</span>
      </div>
    </div>

    <label>Unterordner (optional, innerhalb des Ziels)
      <input id="au-subfolder" placeholder="Standard: Name der Sitzung">
    </label>

    <div class="au-row">
      <label>Zeitlimit (Minuten)
        <input id="au-duration" type="number" min="1" value="120" required>
      </label>
      <label>Max. Dateigröße (MB)
        <input id="au-maxsize" type="number" min="1" value="25">
      </label>
      <label>Max. Dateien pro Person
        <input id="au-maxfiles" type="number" min="1" placeholder="unbegrenzt">
      </label>
    </div>

    <label>Erlaubte Dateiendungen (kommagetrennt, leer = alle)
      <input id="au-ext" placeholder="pdf,jpg,png,jpeg,docx,txt">
    </label>

    <div class="au-defaults-row">
      <button type="button" onclick="saveDefaults()"
        title="Zeitlimit, max. Dateigröße, max. Dateien pro Person und erlaubte Endungen als Voreinstellung für neue Sitzungen speichern">
        Aktuelle Werte als Voreinstellung speichern
      </button>
    </div>

    <button type="submit">Sitzung erstellen</button>
  </form>
  <p id="au-form-msg" class="au-msg"></p>
</section>

<section class="au-block">
  <h2>Sitzungen</h2>
  <ul id="au-list" class="au-list"></ul>
</section>

<!-- Server-side folder browser for picking a custom target folder. -->
<div id="folder-browser" class="folder-browser" style="display: none;">
  <div class="folder-browser__panel">
    <h3>Zielordner auswählen</h3>
    <div id="folder-browser-path" class="folder-browser__path"></div>
    <ul id="folder-browser-list" class="folder-browser__list"></ul>
    <p id="folder-browser-note" class="folder-browser__note"></p>
    <div class="folder-browser__actions">
      <button onclick="createFolderHere()">Neuer Ordner</button>
      <span style="flex: 1"></span>
      <button onclick="closeFolderBrowser()">Abbrechen</button>
      <button id="folder-browser-confirm" onclick="confirmFolder()">Diesen Ordner verwenden</button>
    </div>
  </div>
</div>

<!-- Per-session dashboard: QR, link, submissions, download. -->
<div id="au-dash" class="au-reveal" style="display:none;" onclick="closeDash(event)">
  <div class="au-reveal__panel au-dash__panel" onclick="event.stopPropagation()">
    <button class="au-reveal__close" onclick="closeDash()">✕</button>
    <h3 id="au-dash-name"></h3>
    <div class="au-dash__top">
      <img id="au-dash-qr" class="au-dash__qr" alt="QR code">
      <div class="au-dash__side">
        <div class="au-item__link" id="au-dash-link"></div>
        <div class="au-dash__btns">
          <button onclick="copyText(document.getElementById('au-dash-link').textContent)">Link kopieren</button>
          <button onclick="reviewDash()">Abgaben prüfen</button>
          <button onclick="openPoster(currentDashId)">Poster</button>
          <button onclick="downloadDash()">Alle herunterladen (zip)</button>
          <button onclick="refreshDash()">Aktualisieren</button>
        </div>
        <div id="au-dash-meta" class="meta"></div>
      </div>
    </div>


    <table class="au-dash__table">
      <thead><tr><th>Zeit</th><th>Name</th><th>Datei</th><th>Größe</th><th>Beleg</th></tr></thead>
      <tbody id="au-dash-rows"></tbody>
    </table>
  </div>
</div>

<!-- Share popup: QR + link (always), plus the code once at creation/regeneration. -->
<div id="au-reveal" class="au-reveal" style="display:none;" onclick="closeReveal(event)">
  <div class="au-reveal__panel" onclick="event.stopPropagation()">
    <button class="au-reveal__close" onclick="closeReveal()">✕</button>
    <h3>Mit den Abgebenden teilen</h3>
    <div class="au-reveal__top">
      <img id="au-reveal-qr" class="au-reveal__qr" alt="QR-Code">
      <div class="au-reveal__side">
        <div class="au-reveal__link" id="au-reveal-link"></div>
        <button onclick="copyReveal()">Link kopieren</button>
      </div>
    </div>
    <div id="au-reveal-code-wrap" class="au-reveal__codewrap">
      <div class="au-reveal__codelabel">Zugangscode — wird nur einmal angezeigt. Bei Verlust neu generieren.</div>
      <div class="au-reveal__code" id="au-reveal-code"></div>
    </div>
    <div class="au-reveal__poster">
      <button onclick="openPosterFromReveal()">Poster drucken</button>
      <span class="au-reveal__posterhint">Druckfreundliche Seite mit QR-Code, Link und Zugangscode zum Projizieren oder Aushängen.</span>
    </div>
  </div>
</div>

<style>
  .au-block { margin-top: 1.5rem; }
  .au-form { display: flex; flex-direction: column; gap: 0.6rem; max-width: 32rem; }
  .au-form label { display: flex; flex-direction: column; font-size: 0.9rem; gap: 0.2rem; }
  .au-form input, .au-form select { padding: 0.35rem; }
  .au-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .au-row label { flex: 1; min-width: 8rem; }
  .au-defaults-row { margin-top: 0.2rem; }
  .au-msg { min-height: 1.2em; font-size: 0.9rem; }
  .au-msg.error { color: #b00; }
  .au-msg.ok { color: #070; }
  .au-list { list-style: none; padding: 0; margin: 0; }
  .au-item { border: 1px solid #ddd; border-radius: 8px; padding: 0.75rem; margin-bottom: 0.6rem; }
  .au-item__head { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
  .au-item__name { font-weight: bold; }
  .au-badge { font-size: 0.75rem; padding: 0.1rem 0.45rem; border-radius: 999px; color: #fff; }
  .au-badge.open { background: #2a8; }
  .au-badge.closed { background: #888; }
  .au-badge.expired { background: #b55; }
  .au-item__meta { font-size: 0.82rem; color: #444; margin: 0.35rem 0; }
  .au-item__link { font-family: monospace; font-size: 0.8rem; word-break: break-all; }
  .au-item__actions { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .au-reveal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
  }
  .au-reveal__panel {
    background: #fff; color: #111; width: min(34rem, 90vw);
    padding: 1.25rem; border-radius: 8px; position: relative;
  }
  .au-reveal__close { position: absolute; top: 0.5rem; right: 0.6rem; border: none; background: none; font-size: 1.1rem; cursor: pointer; }
  .au-reveal__top { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start; margin: 0.5rem 0; }
  .au-reveal__qr { width: 160px; height: 160px; border: 1px solid #eee; }
  .au-reveal__side { flex: 1; min-width: 12rem; }
  .au-reveal__codewrap { margin-top: 0.5rem; }
  .au-reveal__codelabel { font-size: 0.8rem; color: #555; }
  .au-reveal__code { font-family: monospace; font-size: 1.8rem; letter-spacing: 0.15em; margin: 0.25rem 0 0; }
  .au-reveal__link { font-family: monospace; font-size: 0.85rem; word-break: break-all; margin-bottom: 0.6rem; }
  .au-dash__panel { width: min(46rem, 92vw); max-height: 86vh; overflow-y: auto; }
  .au-dash__top { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start; margin: 0.5rem 0 1rem; }
  .au-dash__qr { width: 160px; height: 160px; border: 1px solid #eee; }
  .au-dash__side { flex: 1; min-width: 14rem; }
  .au-dash__btns { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.5rem 0; }
  .meta { font-size: 0.8rem; color: #555; }
  .au-reveal__poster { margin-top: 0.8rem; display: flex; align-items: center; gap: 0.5rem; }
  .au-reveal__posterhint { font-size: 0.78rem; color: #667; }
  .au-dash__table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .au-dash__table th, .au-dash__table td { text-align: left; padding: 0.3rem 0.4rem; border-bottom: 1px solid #eee; }
  .au-dash__table td { word-break: break-word; }
  .au-custom-path__label { font-size: 0.9rem; }
  .au-custom-path__row { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.2rem; }
  .au-custom-path__display { font-family: monospace; font-size: 0.8rem; word-break: break-all; color: #444; }
  .folder-browser {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
  }
  .folder-browser__panel {
    background: #fff; color: #111; width: min(40rem, 90vw); max-height: 80vh;
    display: flex; flex-direction: column; padding: 1rem; border-radius: 8px;
  }
  .folder-browser__path { font-family: monospace; font-size: 0.85rem; word-break: break-all; margin-bottom: 0.5rem; }
  .folder-browser__list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; border: 1px solid #ddd; }
  .folder-browser__list li { padding: 0.4rem 0.6rem; cursor: pointer; }
  .folder-browser__list li:hover { background: #eef; }
  .folder-browser__note { color: #b00; font-size: 0.85rem; min-height: 1.2em; margin: 0.4rem 0 0; }
  .folder-browser__actions { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem; }
  .folder-browser__actions button:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script src="/js/admin-upload.js?v=<%= assetVersion %>"></script>
